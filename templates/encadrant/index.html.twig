{% extends 'base.html.twig' %}

{% block title %}Encadrant index{% endblock %}

{% block body %}
    <h1>Encadrant index</h1>

    <form method="get" action="{{ path('app_encadrant_index') }}" class="mb-3">
        <input type="text" name="search" placeholder="Search encadrants..." value="{{ searchTerm|default('') }}">
        <button type="submit">Search</button>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Specialite</th>
                <th>Adresse</th>
                <th>Tel</th>
                <th>Disponibilite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for encadrant in encadrants %}
            <tr>
                <td>{{ encadrant.id }}</td>
                <td>{{ encadrant.nom }}</td>
                <td>{{ encadrant.prenom }}</td>
                <td>{{ encadrant.specialite }}</td>
                <td>{{ encadrant.adresse }}</td>
                <td>{{ encadrant.tel }}</td>
                <td>{{ encadrant.disponibilite ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_encadrant_show', {'id': encadrant.id}) }}">show</a>
                    <a href="{{ path('app_encadrant_edit', {'id': encadrant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_encadrant_new') }}">Create new</a>
{% endblock %}
